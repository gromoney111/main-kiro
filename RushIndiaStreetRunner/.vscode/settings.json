{
  "omnisharp.useModernNet": true,
  "dotnet.defaultSolution": "RushIndiaStreetRunner.sln",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "ms-dotnettools.csharp",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Library": true,
    "**/Temp": true,
    "**/Obj": true,
    "**/Logs": true,
    "**/UserSettings": true
  },
  "search.exclude": {
    "**/Library": true,
    "**/Temp": true
  },
  "[csharp]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
